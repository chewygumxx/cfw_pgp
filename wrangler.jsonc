{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "pgp",
	"compatibility_date": "2026-08-24",
    "workers_dev": false,
    "routes": [
            { "custom_domain": true, "pattern": "openpgpkey.cgxx.dev" },
            { "custom_domain": true, "pattern": "pgp.cgxx.dev" }
        ],
    "assets": {
        "directory": "./",
    }
}
